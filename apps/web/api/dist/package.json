{
  "name": "@publipulse/api",
  "private": true,
  "version": "1.19.1",
  "type": "module",
  "description": "PubliPulse API \u2014 Fastify + PostgreSQL source of truth for signals, actions, outcomes, audit and interoperability.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:db": "vitest run test/db",
    "provision:org": "tsx src/provision-cli.ts",
    "purge:sender-events": "tsx src/purge-sender-events.ts",
    "provision:org:dist": "node dist/provision-cli.js",
    "purge:sender-events:dist": "node dist/purge-sender-events.js"
  },
  "dependencies": {
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/sensible": "^6.0.2",
    "@publipulse/shared": "*",
    "fastify": "^5.2.1",
    "jose": "^6.0.11",
    "pg": "^8.13.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "vitest": "^3.0.5"
  }
}
